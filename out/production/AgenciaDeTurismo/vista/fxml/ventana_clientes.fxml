<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" xmlns:fx="http://javafx.com/fxml" fx:controller="vista.controllers.VentanaClientesController"
      alignment="CENTER" style="-fx-background-color: #f8f8f8; -fx-padding: 20;">

    <Label text="Gestión de Clientes" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

    <TableView fx:id="tablaClientes" prefHeight="250" prefWidth="600">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="150"/>
            <TableColumn fx:id="colApellido" text="Apellido" prefWidth="150"/>
            <TableColumn fx:id="colDni" text="DNI" prefWidth="120"/>
            <TableColumn fx:id="colEmail" text="Email" prefWidth="180"/>
        </columns>
    </TableView>

    <HBox spacing="10" alignment="CENTER">
        <TextField fx:id="txtNombre" promptText="Nombre"/>
        <TextField fx:id="txtApellido" promptText="Apellido"/>
        <TextField fx:id="txtDni" promptText="DNI"/>
        <TextField fx:id="txtEmail" promptText="Email"/>
    </HBox>

    <HBox spacing="10" alignment="CENTER">
        <Button text="Agregar" onAction="#agregarCliente"/>
        <Button text="Eliminar" onAction="#eliminarCliente"/>
        <Button text="Volver" onAction="#volverVentanaPrincipal"/>
    </HBox>
</VBox>