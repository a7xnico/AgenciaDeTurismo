<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="vista.controllers.VentanaHotelesController"
            prefWidth="500" prefHeight="350">

    <children>
        <Label text="Gestión de Hoteles"
               layoutX="150" layoutY="25"
               style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

        <Button text="Volver"
                layoutX="20" layoutY="300"
                onAction="#volverVentanaPrincipal"/>

        <TableView fx:id="tablaHoteles"
                   layoutX="50" layoutY="70"
                   prefWidth="400" prefHeight="200">

            <columns>
                <TableColumn fx:id="colNombre" text="Nombre" prefWidth="150"/>
                <TableColumn fx:id="colUbicacion" text="Ubicación" prefWidth="150"/>
                <TableColumn fx:id="colEstrellas" text="Estrellas" prefWidth="100"/>
            </columns>
        </TableView>
    </children>
</AnchorPane>