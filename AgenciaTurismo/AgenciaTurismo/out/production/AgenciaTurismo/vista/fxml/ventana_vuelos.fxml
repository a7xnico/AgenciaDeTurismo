<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Text?>

<VBox xmlns="http://javafx.com/javafx/8.0.171"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="vista.controllers.VentanaVuelosController"
      spacing="10" alignment="CENTER" style="-fx-background-color: #f4f4f4;" prefWidth="600" prefHeight="400">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Text text="Listado de Vuelos" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <TableView fx:id="tablaVuelos" prefHeight="250" prefWidth="560">
        <columns>
            <TableColumn fx:id="colNumero" text="N° Vuelo" prefWidth="90"/>
            <TableColumn fx:id="colOrigen" text="Origen" prefWidth="100"/>
            <TableColumn fx:id="colDestino" text="Destino" prefWidth="100"/>
            <TableColumn fx:id="colPasajeros" text="Pasajeros" prefWidth="90"/>
            <TableColumn fx:id="colPrecio" text="Precio" prefWidth="90"/>
            <TableColumn fx:id="colFecha" text="Fecha" prefWidth="90"/>
        </columns>
    </TableView>

    <HBox alignment="CENTER">
        <Button fx:id="btnVolver" text="Volver" onAction="#volver"
                style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;"/>
    </HBox>

</VBox>